# Copy to .env and fill in. Never commit .env.
# TCMB EVDS key (https://evds3.tcmb.gov.tr) - only needed to re-download macro series (Step 8)
EVDS_API_KEY=
# Google Gemini key - only needed for real LLM runs (Steps 13-14); everything else runs with --mock
GEMINI_API_KEY=
# Model used in the experiments of Step 14
GEMINI_MODEL=gemini-3.1-flash-lite
